rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Invite list — only the admin manages it. A person may read the invite for their own email
    // (the registration screen uses this to check they were invited).
    match /invites/{email} {
      allow get: if signedIn() && myEmail() == email;
      allow read, write: if isAdmin();
    }

    // Reserves a username (lower-cased) so two people cannot share one.
    // Create-only: it can never be changed. Only the admin releases one, when removing a deleted member.
    match /usernames/{name} {
      allow get: if signedIn();
      allow create: if signedIn()
        && name.matches('^[a-z0-9_-]{3,30}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/invites/$(myEmail()));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Member = the registration table. No password here: Firebase Authentication stores it (hashed).
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['userName', 'email', 'gender', 'role', 'createdAt'])
        && request.resource.data.gender in ['female', 'male', 'other']
        && request.resource.data.role == 'user'                       // admin is set by hand in the console
        && request.resource.data.email == myEmail()
        && request.resource.data.userName.matches('^[A-Za-z0-9_-]{3,30}$')
        && exists(/databases/$(database)/documents/invites/$(myEmail()))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.userName.lower())).data.uid == uid;
      // A member may only flag their own record as deleted (their login is removed at the same time);
      // the admin then sees "Deleted" and removes the row. The username itself never changes.
      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.get('deleted', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt'])
        && request.resource.data.deleted == true;
      allow delete: if isAdmin() && resource.data.get('deleted', false) == true;
    }

    // document_link = one row per user per year (the fact table). The document id is "<uid>_<year>",
    // so a second upload of the same year is rejected as "already exists".
    // Rows are written ONLY by the Apps Script (as project owner, which bypasses these rules).
    // Browsers can read their own rows, never create or edit them — so nobody can point a row
    // at someone else's file. The admin may delete a row to clear a wrong upload.
    match /document_link/{id} {
      // get is decided by the id ("<uid>_<year>") so that asking for a row that does not exist yet
      // answers "not found" instead of "denied"; list (the year picker) is decided by the row's userId
      allow get: if signedIn() && (isAdmin() || id.matches(request.auth.uid + '_[0-9]{4}'));
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // notices = "an admin uploaded <year> for you". Written ONLY by the Apps Script. The member reads
    // their own and deletes each one once they have seen it, so it shows up once and then is gone.
    match /notices/{id} {
      allow get: if signedIn() && id.matches(request.auth.uid + '_[0-9]{4}');
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if false;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // astro_pairs = two people linked by the admin, with their birth details. Only the admin writes them;
    // the admin and the two people in the pair can read them. The app finds a person's pair with an
    // array-contains query on members, which these rules can prove is limited to their own rows.
    match /astro_pairs/{id} {
      function validPair() {
        let d = request.resource.data;
        return d.keys().hasOnly(['members', 'names', 'births', 'by', 'createdAt', 'updatedAt'])
          && d.members is list && d.members.size() == 2 && d.members[0] != d.members[1]
          && d.names is map && d.names.keys().hasOnly(d.members)
          && d.births is map && d.births.keys().hasOnly(d.members) && d.births.size() == 2
          && d.by is string && d.by.size() <= 60;
      }
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.members);
      allow create, update: if isAdmin() && validPair();
      allow delete: if isAdmin();
    }

    // messages = a notification the admin sends to people. Addressed by lower-cased email so it also
    // reaches someone who was invited but has not registered yet. The admin creates them; the person
    // it is addressed to reads it and deletes it once seen, so it shows once and is then gone.
    match /messages/{id} {
      allow get, list: if signedIn() && resource.data.email == myEmail();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'text', 'icon', 'by', 'createdAt', 'deliverAt'])
        && (!('deliverAt' in request.resource.data) || request.resource.data.deliverAt is timestamp)
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && request.resource.data.icon is string && request.resource.data.icon.size() <= 40
        && request.resource.data.by is string && request.resource.data.by.size() <= 60;
      allow update: if false;
      allow delete: if signedIn() && resource.data.email == myEmail();
    }
  }
}
